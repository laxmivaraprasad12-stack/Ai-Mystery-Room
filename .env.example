# Copy this file to server/.env and add your own values.
# Never commit a real .env file or API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
MONGODB_URI=mongodb://127.0.0.1:27017/ai-mystery-room
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
GUEST_RETENTION_DAYS=30
